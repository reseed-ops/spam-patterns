# Spam Patterns configuration. Copy to .env and edit.
# Every variable the service reads is listed here.

# REQUIRED. Deployment-specific secret, at least 32 random bytes as hex.
# Generate with:  openssl rand -hex 32
# There is no working default: the service refuses to start with this
# placeholder. Anyone holding this key plus the stored area code and prefix
# can recover a sender number in at most 10,000 guesses, so treat it like a
# database password. Rotating it makes old sender hashes stop matching new
# ones (duplicate suppression restarts) and changes every pattern ID and the
# way deletion receipts are re-issued on retry; existing receipts keep
# working because only their hash is stored.
STM_HMAC_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32

# demo (default) or live. Demo shows a banner saying the instance is not
# collecting public reports. Live intake is a separate decision (Decision B).
STM_INTAKE_MODE=demo

# Pause intake / read-only mode. 1 refuses new previews and filings with a
# read-only notice; every page keeps working. Takes effect on restart.
# For an immediate switch with no restart, create a file named INTAKE_PAUSED
# in the data directory:  docker compose exec app touch /data/INTAKE_PAUSED
INTAKE_PAUSED=0

# SQLite database file. The deletion journal and the INTAKE_PAUSED file
# live in the same directory.
STM_DATABASE_PATH=/data/spam-text-map.sqlite

# Listen address inside the container.
HOST=0.0.0.0
PORT=8080

# Abuse and cost controls. Per-IP caps are noise control, not abuse proof.
STM_SUBMIT_PER_IP_PER_HOUR=10
STM_GLOBAL_DAILY_SUBMISSIONS=500
STM_DELETE_PER_IP_PER_HOUR=20
STM_FLAG_PER_IP_PER_HOUR=10

# Comma-separated exact IP addresses of the reverse proxies allowed to tell
# the app the client's address (no CIDR ranges or wildcards). Leave empty if
# nothing sits in front of the app. If a proxy is in front and this is empty,
# every visitor shares the proxy's rate limit and same-connection duplicate
# control stays off. WARNING: listing an address that untrusted clients can
# connect from lets them choose their own address.
STM_TRUSTED_PROXIES=
# Which header a trusted proxy uses for the client address:
#   x-forwarded-for (default) - read right to left past trusted proxies;
#   x-real-ip - one address the proxy sets and overwrites (Railway does);
#   cf-connecting-ip - for a CDN (Cloudflare) in front of the trusted proxy.
#     X-Real-IP is resolved as above; only if it lies inside
#     STM_UPSTREAM_CIDRS is CF-Connecting-IP read. Any failed check falls
#     back to the X-Real-IP value. Requires STM_UPSTREAM_CIDRS and
#     STM_TRUSTED_PROXIES, or the service refuses to start.
# The selected value must parse as an IP address, or the socket peer is used.
STM_CLIENT_IP_HEADER=x-forwarded-for
# Comma-separated CIDR ranges (IPv4 and IPv6) of the CDN in front of the
# trusted proxy, e.g. Cloudflare's list from https://www.cloudflare.com/ips/.
# Used only with STM_CLIENT_IP_HEADER=cf-connecting-ip (ignored otherwise).
# Entries must be network addresses with a prefix of /1 or longer; anything
# malformed stops startup. Re-check the published list periodically.
STM_UPSTREAM_CIDRS=

# Same sender hash + same masked template within this window does not count
# again toward patterns or area-code counts.
STM_DUPLICATE_WINDOW_HOURS=24
# Internal sender hashes are erased after this many days.
STM_SENDER_TOKEN_TTL_DAYS=30

# Contacts shown on the privacy, data and project pages (mailto links).
STM_ABUSE_CONTACT=abuse@example.invalid
STM_SECURITY_CONTACT=security@example.invalid
STM_PRIVACY_CONTACT=privacy@example.invalid

# Screenshot limits enforced in the browser before local OCR runs.
STM_MAX_SCREENSHOT_MB=8
STM_MAX_SCREENSHOT_PIXELS=16000000

# Optional: URL of the official instance, shown on the project page.
STM_OFFICIAL_INSTANCE_URL=
