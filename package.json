{
  "name": "spam-text-map",
  "version": "0.1.8",
  "private": true,
  "description": "Privacy-first anonymous intake and formula-level grouping of unsolicited text messages.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.ts",
    "vendor": "node scripts/vendor-ocr.mjs",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.ts",
    "flags": "node --disable-warning=ExperimentalWarning src/flags-cli.ts",
    "backup": "node --disable-warning=ExperimentalWarning src/backup.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --disable-warning=ExperimentalWarning --test --test-concurrency=1 --test-reporter=spec test/*.test.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
